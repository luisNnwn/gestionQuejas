# Flask dashboard
FLASK_SECRET_KEY=replace-with-a-long-random-secret
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-unique-strong-password
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
N8N_CONTROL_TOKEN=replace-with-another-long-random-token
COOKIE_SECURE=false

# n8n public URL used for editor and webhook callbacks
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/
N8N_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
GENERIC_TIMEZONE=America/El_Salvador
